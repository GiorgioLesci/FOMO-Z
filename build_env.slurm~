#!/bin/bash
#SBATCH --job-name=conda_build_fomoz
#SBATCH --time=02:00:00
#SBATCH --mem=8G
#SBATCH --cpus-per-task=4
#SBATCH --output=conda_build.log
#SBATCH --error=conda_build.err

# Load required modules
module purge
module load anaconda3/2023.09

# Initialize conda for bash
source $CONDA_HOME/etc/profile.d/conda.sh

# Check if the environment already exists
ENV_NAME="fomoz"
if conda info --envs | grep -q "${ENV_NAME}"; then
    echo "Environment '${ENV_NAME}' exists. Removing it first..."
    conda env remove -n ${ENV_NAME} -y
    echo "Old environment removed."
else
    echo "Environment '${ENV_NAME}' not found. Proceeding with creation."
fi

# Create the environment from YAML file
echo "Creating new environment '${ENV_NAME}'..."
conda env create -f environment.yaml

# Verify environment was created
echo "Listing available environments:"
conda info --envs

echo "Done. Use: conda activate ${ENV_NAME}"

